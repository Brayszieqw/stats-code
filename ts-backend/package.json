{
  "name": "stats-code-ts-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Stats Code TypeScript backend (Node.js 22): api + server + engine, SEA single-exe.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/api",
    "packages/server",
    "packages/engine"
  ],
  "scripts": {
    "build": "node scripts/embed-matrix.mjs && node scripts/embed-templates.mjs && tsc --build",
    "clean": "tsc --build --clean",
    "typecheck": "tsc --build --noEmit",
    "lint": "eslint . --ext .ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:property": "vitest run tests/property",
    "test:parity": "vitest run tests/parity",
    "parity": "node scripts/run-parity.mjs",
    "bundle": "node scripts/bundle.mjs",
    "sea": "node scripts/build-sea.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "release-meta": "node scripts/release-meta.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "esbuild": "^0.24.0",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-import": "^2.31.0",
    "postject": "^1.0.0-alpha.6",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "fast-check": "^3.23.1"
  }
}
